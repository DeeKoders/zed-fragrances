# Template only: copy to .env (or .env.local) and fill in. Add the same variables in Netlify
# (Site configuration → Environment variables). Setup guide: google-apps-script/README.md

# Web app URL of the orders Apps Script (Deploy → Manage deployments). Ends in /exec.
ORDERS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Long random string, identical to SECRET in google-apps-script/Code.gs. Make one with: openssl rand -hex 32
ORDERS_SCRIPT_SECRET=

# Password for the admin portal at /admin. Use a long one (a passphrase of 4+ words, or openssl rand -base64 18).
# Changing it signs out every device.
ADMIN_PASSWORD=
